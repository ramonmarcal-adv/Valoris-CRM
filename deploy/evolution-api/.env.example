# Copy this file to `.env` in the same folder and fill in real values:
#   cp .env.example .env
#
# Never commit the real `.env` — it holds the Evolution API key and the
# Postgres password. This folder's .gitignore already excludes it.

# ---- Domain (used by Caddy for automatic HTTPS — see Caddyfile) ----
# Must already have an A record pointing at this VPS's public IP.
EVOLUTION_DOMAIN=evolution.seudominio.com.br

# ---- Evolution API ----
# Shared secret every request to this server must send in the `apikey`
# header. Generate a long random value (e.g. `openssl rand -hex 32`) —
# do NOT keep the example below. This is the exact value you'll paste
# into the CRM's Settings → WhatsApp → Evolution API tab as "API Key".
AUTHENTICATION_API_KEY=troque-por-uma-chave-aleatoria-longa

# ---- Database ----
DATABASE_PROVIDER=postgresql
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ---- Cache (Redis) ----
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# ---- Webhook ----
# Left disabled here on purpose — the Valoris CRM registers its own
# per-account webhook URL automatically when you save the Evolution API
# config in Settings (see setEvolutionWebhook() in
# src/lib/whatsapp/evolution-api.ts). You don't need to set a global
# webhook URL by hand.
WEBHOOK_GLOBAL_ENABLED=false
